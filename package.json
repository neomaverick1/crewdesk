{
  "name": "crewdesk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/main.ts",
    "dev:web": "vite",
    "dev:demo": "VITE_DEMO=1 vite",
    "build": "vite build",
    "build:demo": "VITE_DEMO=1 vite build",
    "start": "NODE_ENV=production node server/main.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "android": "npm run build:demo && cap sync android",
    "ios": "npm run build:demo && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
